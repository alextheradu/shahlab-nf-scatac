nextflow_process {

    name "Test Process ULTRAPLEX"
    script "modules/local/ultraplex/main.nf"
    process "ULTRAPLEX"

    test("demultiplexes a small fastq into ATAC/WGS/nomatch") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test_sample' ],
                    file("${projectDir}/tests/fixtures/tiny_atac.fastq.gz")
                ]
                input[1] = file("/data1/shahs3/users/mcphera1/projects/datac/barcodes.csv")
                input[2] = "CTGTCTCTTATACACATCT"
                input[3] = "CTGTCTCTTATACACATCTGACGCTGCCGACGA"
                """
            }
        }

        then {
            assert process.success
            assert process.out.atac.size() == 1
            assert process.out.wgs.size() == 1
            assert process.out.nomatch.size() == 1
        }
    }
}
